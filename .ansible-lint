---
# roles-galaxy/ is downloaded by `make update-ansible-roles` and overwritten on
# every update, so linting or hand-fixing it is wasted work. Everything we own
# (playbook.yml, roles/) must stay clean.
exclude_paths:
  - roles-galaxy/
  - .ansible/

# Vendored roles carry their own callback/config habits; we only care about ours.
skip_list:
  - galaxy[no-changelog]
