# Managed by Ansible (vps1-provisioning, role mail_server).
#
# Outgoing mail from the application on this box. No virtual users, no
# mailboxes: Postfix accepts from loopback, OpenDKIM signs, and it delivers.

myhostname = {{ mail_server_hostname }}
mydomain = {{ mail_server_dkim_domain }}
myorigin = $mydomain

# The containers on this host talk to Postfix over the docker bridge, which is
# not loopback inside the network namespace: `loopback-only` made the service
# unreachable from the app and every signup failed to send. Listening on all
# interfaces is safe because mynetworks below still only relays for loopback and
# the docker bridge, and port 25 is closed in ufw.
inet_interfaces = all
inet_protocols = ipv4
# Relaying is limited to this machine and the docker bridge. The bridge address
# is where a container's packets arrive from; without it the app is treated as a
# stranger and refused.
mynetworks = {{ mail_server_networks | join(', ') }}

# No local delivery: nobody reads mail on this box.
mydestination =

# Hand every message to OpenDKIM on the way out.
smtpd_milters = {{ mail_server_milter }}
non_smtpd_milters = {{ mail_server_milter }}
milter_default_action = accept
milter_protocol = 6

# Postfix 3 refuses to start without at least one working relay restriction.
# reject_unauth_destination is the one that keeps this from being an open relay:
# it accepts mail for our own domains and refuses to forward anything else.
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination, reject_non_fqdn_recipient, reject_unknown_recipient_domain

# No NIS on this box; without this smtpd logs a warning on every start.
smtpd_sasl_auth_enable = no

smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

# Helo and reverse DNS are checked by the receiver; being wrong about our own
# name is the one thing we control.
smtp_helo_name = {{ mail_server_hostname }}

message_size_limit = {{ mail_server_message_size_limit }}
mailbox_size_limit = 0

smtpd_use_tls = no
smtp_tls_security_level = may

# A cold IP that sends a burst is throttled by receivers anyway; staying under
# the limits is cheaper than being told to.
default_destination_rate_delay = 1s
smtp_destination_concurrency_limit = 2

# Bounce traffic needs a real address to come back to.
recipient_delimiter = +
